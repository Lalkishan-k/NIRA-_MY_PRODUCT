{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "E-commerce coconut oil product item in the store catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 5000 },
        "price": { "type": "number" },
        "compareAtPrice": { "type": "number" },
        "discount": { "type": "number" },
        "stock": { "type": "number" },
        "sku": { "type": "string", "maxLength": 100 },
        "size": { "type": "string", "maxLength": 50 },
        "unit": { "type": "string", "maxLength": 50 },
        "images": { "type": "array" },
        "ingredients": { "type": "array" },
        "benefits": { "type": "array" },
        "usage": { "type": "array" },
        "storage": { "type": "string", "maxLength": 500 },
        "featured": { "type": "boolean" },
        "active": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "price", "stock", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order including Razorpay transaction details and delivery status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingCost": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "paymentStatus": { "type": "string", "maxLength": 50 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "razorpayOrderId": { "type": "string", "maxLength": 128 },
        "razorpayPaymentId": { "type": "string", "maxLength": 128 },
        "razorpaySignature": { "type": "string", "maxLength": 256 },
        "orderStatus": { "type": "string", "maxLength": 50 },
        "estimatedDelivery": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "customerId", "customerName", "email", "phone", "totalAmount", "paymentStatus", "orderStatus"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public customer profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Sensitive customer profile PII (phone, email, addresses)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "addresses": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount codes",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 50 },
        "discountType": { "type": "string", "enum": ["percentage", "flat"] },
        "discountValue": { "type": "number" },
        "minimumOrderAmount": { "type": "number" },
        "maximumDiscount": { "type": "number" },
        "expiryDate": { "type": "string", "maxLength": 50 },
        "usageLimit": { "type": "number" },
        "usedCount": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["code", "discountType", "discountValue", "active"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product reviews and ratings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 200 },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 },
        "review": { "type": "string", "maxLength": 2000 },
        "verifiedPurchase": { "type": "boolean" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "customerId", "customerName", "rating", "review"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public store product catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders with secure ownership enforcement"
    },
    "/users/{userId}/public/profile": {
      "schema": "UserProfile",
      "description": "Public customer profile"
    },
    "/users/{userId}/private/info": {
      "schema": "UserPrivate",
      "description": "Customer private delivery addresses and contact information"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Promotional discount codes managed by admin"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer reviews and moderation state"
    }
  }
}
