# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- RAZORPAY PAYMENT GATEWAY (SERVER SECRETS & CLIENT KEY) ---
# Server-side secrets (NEVER exposed to frontend):
RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
# Client-side key for Razorpay checkout modal:
VITE_RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"

# --- FIREBASE CLIENT CONFIGURATION ---
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="cocopure-store.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="cocopure-store"
VITE_FIREBASE_STORAGE_BUCKET="cocopure-store.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# --- BUSINESS & SHIPPING CONFIGURATION ---
VITE_STORE_NAME="CocoPure"
VITE_STORE_TAGLINE="Pure Coconut Oil. Naturally Better."
VITE_WHATSAPP_NUMBER="+919876543210"
VITE_SUPPORT_EMAIL="hello@cocopure.in"
VITE_SUPPORT_PHONE="+91 98765 43210"
VITE_FREE_SHIPPING_THRESHOLD="499"
VITE_SHIPPING_CHARGE="50"

