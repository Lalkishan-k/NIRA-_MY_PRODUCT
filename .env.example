# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- RAZORPAY PAYMENT GATEWAY (SERVER SECRETS & CLIENT KEY) ---
# Server-side secrets (NEVER exposed to frontend):
RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
# Client-side key for Razorpay checkout modal:
VITE_RAZORPAY_KEY_ID="rzp_test_YourTestKeyId"

# --- FIREBASE CLIENT CONFIGURATION ---
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="cocopure-store.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="cocopure-store"
VITE_FIREBASE_STORAGE_BUCKET="cocopure-store.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# --- GOOGLE MAPS PLATFORM ---
# Google Maps API Key for Maps Static API (Store Locator)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# --- EMAILJS AUTOMATED NOTIFICATIONS ---
VITE_EMAILJS_SERVICE_ID="service_yx9z7ta"
VITE_EMAILJS_TEMPLATE_ID="template_c5ux4ls"
VITE_EMAILJS_PUBLIC_KEY="9fDY4SGMu4-8EuYZO"

# --- STORE OWNER & ADMIN AUTHENTICATION SECRETS ---
